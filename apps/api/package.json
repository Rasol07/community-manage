{
  "name": "@community/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsdown src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@community/shared": "workspace:*",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.10.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "msw": "^3.0.7",
    "pino-pretty": "^13.2.0",
    "prisma": "8.0.0-rc.34",
    "supertest": "^7.3.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
